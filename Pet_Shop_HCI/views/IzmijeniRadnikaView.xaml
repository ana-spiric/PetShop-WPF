<Window x:Class="Pet_Shop_HCI.views.IzmijeniRadnikaView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Pet_Shop_HCI.views" xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
        mc:Ignorable="d"
        Height="450" Width="400"
        Background="Transparent"
        AllowsTransparency="True" WindowStyle="None"
        ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen">

    <WindowChrome.WindowChrome>
        <WindowChrome CornerRadius="7" />
    </WindowChrome.WindowChrome>

    <Border CornerRadius="7" BorderThickness="1.5" BorderBrush="{DynamicResource color1}"
            Background="{DynamicResource newWindowColor}">

        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="25"/>
                <RowDefinition Height="38" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--x button-->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Grid.Row="0">
                <Button x:Name="btnClose"
                                Style="{StaticResource controlButton1}"
                                Tag="{StaticResource color4}"
                                Click="btnClose_Click"
                                Height="20">
                    <fa:IconImage Icon="Xmark" Style="{StaticResource controlButtonIcon}"/>
                </Button>
            </StackPanel>

            <TextBlock Text="Izmjena radnika"
                       FontSize="16" FontWeight="Medium"
                       Foreground="{DynamicResource color1}"
                       FontFamily="Montserrat"
                       HorizontalAlignment="Center" Margin="0,0,0,20" 
                       Grid.Row="1"/>


            <StackPanel Grid.Row="2" HorizontalAlignment="Center">
                <StackPanel Margin="0,10">
                    <TextBlock Text="Matični broj:" 
                               Style="{StaticResource TextBlockStyle}"/>

                    <Border BorderBrush="{DynamicResource textBox}" BorderThickness="1">
                    <TextBlock x:Name="JMBTxt" Text="{Binding Jmb}" 
                               Width="200" Background="#F0F0F0" Padding="5" 
                               VerticalAlignment="Center" IsHitTestVisible="False"/>
                    </Border>
                </StackPanel>

                <StackPanel Margin="0,10">
                    <TextBlock Text="Ime:" 
                               Style="{StaticResource TextBlockStyle}"/>

                    <TextBox x:Name="ImeTxt" Text="{Binding Ime}" 
                             Style="{StaticResource TextBoxStyle}"/>
                </StackPanel>

                <StackPanel Margin="0,10">
                    <TextBlock Text="Prezime:" 
                               Style="{StaticResource TextBlockStyle}"/>

                    <TextBox x:Name="PrezimeTxt" Text="{Binding Prezime}" 
                             Style="{StaticResource TextBoxStyle}"/>
                </StackPanel>

                <StackPanel Margin="0,10">
                    <CheckBox x:Name="AdministratorChk" Content="Administrator" 
                              IsChecked="{Binding Admin}" 
                              FontWeight="Medium" 
                              FontFamily="Montserrat"
                              VerticalAlignment="Center" HorizontalAlignment="Left"
                              Foreground="{DynamicResource color1}"/>
                </StackPanel>

                <StackPanel Margin="0,10">
                    <CheckBox x:Name="StatusChk" Content="Status" 
                              IsChecked="{Binding Status}"
                              FontWeight="Medium" 
                              FontFamily="Montserrat"
                              VerticalAlignment="Center" HorizontalAlignment="Left"
                              Foreground="{DynamicResource color1}"/>
                </StackPanel>

                <Button Content="Sačuvaj"
                        Width="70" Height="30"
                        Margin="0,20,0,0" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Style="{DynamicResource dodajRadnikaButton}"
                        Click="ButtonSacuvajPromjene_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
