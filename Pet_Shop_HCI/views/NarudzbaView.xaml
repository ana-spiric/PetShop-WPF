<UserControl x:Class="Pet_Shop_HCI.views.NarudzbaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Pet_Shop_HCI.views" xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
             mc:Ignorable="d" 
             d:DesignHeight="550" d:DesignWidth="800">

    <Border Background="Transparent" Padding="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition Height="50"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40"/>
                        <RowDefinition/>
                        <RowDefinition Height="40"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">

                        <DockPanel VerticalAlignment="Center" Margin="10,3,10,3" HorizontalAlignment="Left">
                            <fa:IconImage  DockPanel.Dock="Left" Icon="Search" Height="15" Width="15" Foreground="#200f53"/>
                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                             x:Name="SearchTextBox"
                             VerticalAlignment="Center"
                             GotFocus="SearchTextBox_GotFocus"
                             Margin="5,5,0,5"
                             TextChanged="SearchTextBox_TextChanged"
                             Height="30" Width="350"
                             VerticalContentAlignment="Center"
                             HorizontalContentAlignment="Left">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter"
                                        Command="{Binding Search}"/>
                                </TextBox.InputBindings>
                            </TextBox>
                        </DockPanel>
                    </Grid>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding ProizvodiView}"
                              x:Name="ProizvodiDataGrid"
                              AutoGeneratedColumns="DataGrid_AutoGeneratedColumns"
                              Margin="10,20,10,10"
                              SelectedItem="{Binding SelectedProduct}"
                              CanUserResizeRows="False"
                              IsReadOnly="True"
                              Style="{StaticResource CustomDataGridStyle1}"
                              HorizontalAlignment="Stretch">

                    </DataGrid>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="65"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                               Text="Količina"
                               FontFamily="Montserrat"
                               FontSize="15"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               Foreground="White"
                               Margin="10,10,0,0">

                        </TextBlock>

                        <TextBox Grid.Column="1"
                             Margin="2,10,10,2"
                             FontFamily="Montserrat"
                             FontSize="15"
                             Height="25"
                             Text="{Binding Kolicina}"
                             VerticalContentAlignment="Center"
                             HorizontalContentAlignment="Right"
                             PreviewTextInput="TextBox_PreviewTextInput">

                        </TextBox>

                        <Button Grid.Column="2"
                      
                        Style="{DynamicResource dodajRadnikaButton}"
                        VerticalAlignment="Center"
                        
                       
                        Content="Dodaj"
                        Command="{Binding Dodaj}"
                             Width="60" Height="25" Margin="0,0,10,0" HorizontalAlignment="Right">

                        </Button>
                    </Grid>

                </Grid>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <!--dodaj dobavljaca i combo box dovavljaca-->
                        <RowDefinition Height="40"/>
                        <!--tabela-->
                        <RowDefinition/>
                        <!--ukupna cijena-->
                        <RowDefinition Height="40"/>
                        <!--ukloni dugme-->
                        <RowDefinition Height="40"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="85"/>
                            <ColumnDefinition Width="250"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                               Text="Dobavljač"
                               FontFamily="Montserrat"
                               FontSize="15"
                               HorizontalAlignment="Left"
                               VerticalAlignment="Center"
                               Foreground="White"
                               Margin="10,10,0,0"/>

                        <ComboBox Grid.Column="1"
                                  Width="220"
                             Margin="5,10,10,2"
                             FontFamily="Montserrat"
                             FontSize="15"
                             Height="25"
                             VerticalContentAlignment="Center"
                             HorizontalContentAlignment="Left" 
                             ItemsSource="{Binding Dobavljaci}"
                             SelectedValue= "{Binding SelectedDobavljac}">
                        </ComboBox>


                        <Button Grid.Column="2" Style="{DynamicResource dodajRadnikaButton}" Margin="10,5,0,0" Click="DodajDobavljacaButton_Click"
                                VerticalAlignment="Center" HorizontalAlignment="Left" Width="130" Grid.ColumnSpan="2" Height="25">
                            <StackPanel Orientation="Horizontal" >
                                <fa:IconImage Icon="Plus" VerticalAlignment="Center" Width="11" 
                                    Height="11" Margin="0,1,8,0"/>
                                <TextBlock Text="Novi dobavljač"/>
                            </StackPanel>
                        </Button>

                    </Grid>

                   

                    <DataGrid Grid.Row="1" ItemsSource="{Binding StavkeNarudzbe}"
                              x:Name="NarudzbaDataGrid"
                              Margin="10,20,10,10"
                              FontSize="15" FontFamily="Montserrat"
                              SelectedItem="{Binding SelectedProduct}"
                              IsReadOnly="True" HorizontalAlignment="Left"
                              Style="{StaticResource CustomDataGridStyle1}"
                              AutoGeneratedColumns="DataGrid_AutoGeneratedColumnsNarudzba">

                    </DataGrid>

                    <Grid Grid.Row="2" Grid.Column="2" HorizontalAlignment="Right">
                        <Grid.ColumnDefinitions>
                            <!--tekst-->
                            <ColumnDefinition Width="150"/>
                            <!--ukupna cijena-->
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Ukupna cijena (KM)"
                                   FontFamily="Montserrat" FontSize="15"
                                   VerticalAlignment="Center" Foreground="White"/>
                        <TextBlock Grid.Column="1" Text="{Binding UkupnaCijena}" FontFamily="Montserrat" FontSize="17"
                                   TextAlignment="Center" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Center"
                                   Width="65"/>

                    </Grid>

                    <Button Grid.Row="3" 
                            Style="{DynamicResource dodajRadnikaButton}" VerticalAlignment="Center"
                            Content="Ukloni" Margin="0,0,10,0" Width="70" HorizontalAlignment="Right"
                            Command="{Binding Ukloni}" Grid.ColumnSpan="2"/>

                </Grid>
            </Grid>

            <Button Grid.Row="2" 
                    Style="{DynamicResource dodajRadnikaButton}" VerticalAlignment="Center"
                            Content="Kreiraj narudžbu" Margin="0,0,10,0" Width="115" HorizontalAlignment="Right"
                            Command="{Binding KreirajNarudzbu}" Grid.ColumnSpan="2"/>

        </Grid>
        
        
    </Border>
    
</UserControl>
