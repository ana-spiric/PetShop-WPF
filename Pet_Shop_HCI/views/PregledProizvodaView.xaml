<UserControl x:Class="Pet_Shop_HCI.views.PregledProizvodaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Pet_Shop_HCI.views" xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    
    
    <Border Background="Transparent" Padding="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <!--search bar-->
                <RowDefinition Height="50"/>
                <RowDefinition Height="45"/>
                <!--tabela-->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0" VerticalAlignment="Stretch">
                <Button Style="{DynamicResource dodajRadnikaButton}" Content="Svi proizvodi" Width="100" Margin="5" Click="SviProizvodi_Click"/>
                <Button Style="{DynamicResource dodajRadnikaButton}" Content="Ljubimci" Width="100" Margin="5" Click="Ljubimci_Click"/>
                <Button Style="{DynamicResource dodajRadnikaButton}" Content="Asesoar" Width="100" Margin="5" Click="Asesoar_Click"/>
            </StackPanel>


            <DockPanel Grid.Row="1" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Margin="10,0,10,0">
                <fa:IconImage  DockPanel.Dock="Left" Icon="Search" Height="15" Width="15" Foreground="#200f53" Margin="0,0,5,0"/>
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                            x:Name="SearchTextBox"
                            VerticalAlignment="Stretch"
                            HorizontalAlignment="Stretch"
                            GotFocus="SearchTextBox_GotFocus"
                            Margin="0"
                            TextChanged="SearchTextBox_TextChanged"
                            VerticalContentAlignment="Center"
                            HorizontalContentAlignment="Left"
                            Height="30">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter"
                                    Command="{Binding Search}"/>
                    </TextBox.InputBindings>
                </TextBox>
            </DockPanel>


            <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,20,0">
                <Button Style="{DynamicResource dodajRadnikaButton}" Click="DodajProizvodButton_Click">
                    <StackPanel Orientation="Horizontal" >
                        <fa:IconImage Icon="Plus" VerticalAlignment="Center" Width="11" 
                                      Height="11" Margin="0,1,8,0"/>
                        <TextBlock Text="Dodaj novi proizvod"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!--Background="White"
                      RowBackground="#D3EED1"
                      AlternatingRowBackground="#EAF6E6"
                      CanUserAddRows="False"
                      IsReadOnly="True"-->
            
            <DataGrid x:Name="ProizvodiDataGrid"
                      Grid.Row="3"
                      ItemsSource="{Binding proizvodiView}"
                      AutoGenerateColumns="True"
                      Margin="10"
                      IsReadOnly="True"
                      Style="{StaticResource CustomDataGridStyle1}"
                      AutoGeneratedColumns="DataGrid_AutoGeneratedColumns"
                      CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTemplateColumn>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Ukloni"
                                        Command="{Binding DataContext.Ukloni, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                        CommandParameter="{Binding}" 
                                        Style="{StaticResource editButton}"
                                        >
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Izmijeni"
                                        Command="{Binding DataContext.Izmijeni, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                        CommandParameter="{Binding}" 
                                        Style="{StaticResource editButton}"
                                        >
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
                
            </DataGrid>
            

            <TextBlock Grid.Row="3"
                   Text="Nema dostupnih proizvoda"
                   Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibilityConverter}}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   FontSize="16"
                   Foreground="Gray" />
        </Grid>

    </Border>
</UserControl>
