<UserControl x:Class="Pet_Shop_HCI.views.PregledRacunaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Pet_Shop_HCI.views" xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Border Background="Transparent" Padding="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!--<StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0" VerticalAlignment="Stretch">
                <ComboBox Margin="10"
                          FontFamily="Montserrat"
                          FontSize="15"
                          Height="25"
                          Width="150"
                          VerticalContentAlignment="Center"
                          HorizontalContentAlignment="Right" 
                          ItemsSource="{Binding Dobavljaci}"
                          SelectedValue= "{Binding SelectedDobavljac}" />

                <DatePicker FontFamily="Montserrat"
                            FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"
                            Foreground="White" Margin="10" Height="30" Width="150"/>

                <Button  Style="{DynamicResource dodajRadnikaButton}" 
                            Content="Pretraži" Width="100" Margin="10" HorizontalAlignment="Left" VerticalAlignment="Center"/>

            </StackPanel>-->

            <DockPanel Grid.Row="0" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Margin="10,0,10,0">
                <fa:IconImage  DockPanel.Dock="Left" Icon="Search" Height="15" Width="15" Foreground="#200f53" Margin="0,0,5,0"/>
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                            x:Name="SearchTextBox"
                            VerticalAlignment="Stretch"
                            HorizontalAlignment="Stretch"
                            GotFocus="SearchTextBox_GotFocus"
                            Margin="0"
                            TextChanged="SearchTextBox_TextChanged"
                            VerticalContentAlignment="Center"
                            HorizontalContentAlignment="Left"
                            Height="30">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter"
                                    Command="{Binding Search}"/>
                    </TextBox.InputBindings>
                </TextBox>
            </DockPanel>

            <DataGrid Grid.Row="2" x:Name="RacuniDataGrid" 
                      ItemsSource="{Binding racuniView}"
                      Margin="10"
                      IsReadOnly="True"
                      Style="{StaticResource CustomDataGridStyle1}"
                      CanUserAddRows="False"
                      AutoGenerateColumns="True"
                      AutoGeneratedColumns="DataGrid_AutoGeneratedColumns">
                <DataGrid.Columns>
                    <DataGridTemplateColumn>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Pregled" Width="60"
                                        Command="{Binding DataContext.Pregledaj, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                        CommandParameter="{Binding}" 
                                        Style="{StaticResource editButton}">
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

    </Border>
</UserControl>
