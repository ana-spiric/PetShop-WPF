<Window x:Class="Pet_Shop_HCI.views.StavkeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Pet_Shop_HCI.views" xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
        mc:Ignorable="d"
        Height="400" Width="650"
        Background="Transparent"
        AllowsTransparency="True" WindowStyle="None"
        ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen">
    <WindowChrome.WindowChrome>
        <WindowChrome CornerRadius="7" />
    </WindowChrome.WindowChrome>
    <Border CornerRadius="7" BorderThickness="1.5" BorderBrush="{DynamicResource color1}"
            Background="#ADBDB5">

        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="25"/>
                <RowDefinition Height="60"/>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="40"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Top">
                <TextBlock Text="{Binding Podaci}" VerticalAlignment="Center" HorizontalAlignment="Center"
                           Foreground="{DynamicResource color1}" FontWeight="Medium" FontSize="16" FontFamily="Montserrat"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Grid.Row="0">
                <Button x:Name="btnClose"
                                Style="{StaticResource controlButton1}"
                                Tag="{StaticResource color4}"
                                Click="btnClose_Click"
                                Height="20">
                    <fa:IconImage Icon="Xmark" Style="{StaticResource controlButtonIcon}"/>
                </Button>
            </StackPanel>

            <DockPanel Grid.Row="2" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Margin="10,0,10,0">
                <fa:IconImage  DockPanel.Dock="Left" Icon="Search" Height="15" Width="15" Foreground="#200f53" Margin="0,0,5,0"/>
                <TextBox Text="{Binding SearchTextRacun, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                            x:Name="SearchTextBox"
                            VerticalAlignment="Stretch"
                            HorizontalAlignment="Stretch"
                            GotFocus="SearchTextBox_GotFocus"
                            Margin="0"
                            TextChanged="SearchTextBox_TextChanged"
                            VerticalContentAlignment="Center"
                            HorizontalContentAlignment="Left"
                            Height="30">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter"
                                    Command="{Binding SearchRacun}"/>
                    </TextBox.InputBindings>
                </TextBox>
            </DockPanel>

            <DataGrid x:Name="StavkeGrid"
                      Grid.Row="3"
                      ItemsSource="{Binding StavkeView}"
                      AutoGenerateColumns="True"
                      Margin="10"
                      IsReadOnly="True"
                      Style="{StaticResource CustomDataGridStyle1}"
                      CanUserAddRows="False"
                      AutoGeneratedColumns="DataGrid_AutoGeneratedColumnsN">

            </DataGrid>
            <Grid Grid.Row="4" RenderTransformOrigin="0.556,0.64">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="191*"/>
                    <ColumnDefinition Width="217*"/>
                    <ColumnDefinition Width="122*"/>
                    <ColumnDefinition Width="60*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="2" Text="Ukupna cijena (KM)"
                               FontFamily="Montserrat" FontSize="13" HorizontalAlignment="Center" FontWeight="Medium"
                               VerticalAlignment="Center" Foreground="{DynamicResource color1}" Height="18" Margin="0" Width="120"/>
                <TextBlock Grid.Column="3" Text="{Binding Cijena}" FontFamily="Montserrat" FontSize="14"
                               TextAlignment="Center" Foreground="{DynamicResource color1}" VerticalAlignment="Center" HorizontalAlignment="Left"
                               Width="55" Height="20" Margin="0,10,0,10"/>
            </Grid>
        </Grid>

    </Border>
</Window>
