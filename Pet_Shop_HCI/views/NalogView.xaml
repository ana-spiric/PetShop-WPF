<Window x:Class="Pet_Shop_HCI.views.NalogView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Pet_Shop_HCI.views" xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
        mc:Ignorable="d"
        Height="300" Width="400"
        Background="Transparent"
        AllowsTransparency="True" WindowStyle="None"
        ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen">

    <WindowChrome.WindowChrome>
        <WindowChrome CornerRadius="7" />
    </WindowChrome.WindowChrome>

    <Border CornerRadius="7" BorderThickness="1.5" BorderBrush="{DynamicResource color1}"
            Background="{DynamicResource newWindowColor}">
        
        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="25"/>
                <RowDefinition Height="38" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Grid.Row="0">
                <Button x:Name="btnClose"
                                Style="{StaticResource controlButton1}"
                                Tag="{StaticResource color4}"
                                Click="btnClose_Click"
                                Height="20">
                    <fa:IconImage Icon="Xmark" Style="{StaticResource controlButtonIcon}"/>
                </Button>
            </StackPanel>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="ImeTxt" Grid.Column="0" Text="{Binding Ime}" 
                           FontWeight="SemiBold" FontFamily="Montserrat" FontSize="16"
                           Margin="0,5,0,5" HorizontalAlignment="Right"
                           Foreground="{DynamicResource color1}"/>

                <TextBlock x:Name="PrezimeTxt" Grid.Column="2" Text="{Binding Prezime}" 
                           FontWeight="SemiBold" FontFamily="Montserrat" FontSize="16"
                           Margin="5,5,0,5" HorizontalAlignment="Left"
                           Foreground="{DynamicResource color1}"/>
            </Grid>

            <StackPanel Grid.Row="2" HorizontalAlignment="Center">
                <StackPanel Margin="0,10">
                    <TextBlock Text="Korisničko ime:" 
                               Style="{StaticResource TextBlockStyle}"/>

                    <TextBox x:Name="KImeTxt" Text="{Binding KorisnickoIme}" 
                              Style="{StaticResource TextBoxStyle}"/>
                </StackPanel>

                <StackPanel Margin="0,10">
                    <TextBlock Text="Lozinka (ako želite promijeniti lozinku):" 
                               Style="{StaticResource TextBlockStyle}"/>

                    <TextBox x:Name="LozinkaTxt"
                               Style="{StaticResource TextBoxStyle}"/>
                </StackPanel>

                <Button Content="Sačuvaj"
                        Width="70" Height="30"
                        Margin="0,20,0,0" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Style="{DynamicResource dodajRadnikaButton}"
                        Click="ButtonSacuvajPromjene_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
