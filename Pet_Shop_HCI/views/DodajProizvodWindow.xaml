<Window x:Class="Pet_Shop_HCI.views.DodajProizvodWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Pet_Shop_HCI.views" xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
        mc:Ignorable="d"
        Height="500" Width="500"
        Background="Transparent"
        AllowsTransparency="True" WindowStyle="None"
        ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen">

    <WindowChrome.WindowChrome>
        <WindowChrome CornerRadius="7" />
    </WindowChrome.WindowChrome>

    <Border CornerRadius="7" BorderThickness="1.5" BorderBrush="{DynamicResource color1}"
            Background="{DynamicResource newWindowColor}">

        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="25"/>
                <RowDefinition Height="38"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Grid.Row="0">
                <Button x:Name="btnClose"
                                Style="{StaticResource controlButton1}"
                                Tag="{StaticResource color4}"
                                Click="btnClose_Click"
                                Height="20">
                    <fa:IconImage Icon="Xmark" Style="{StaticResource controlButtonIcon}"/>
                </Button>
            </StackPanel>

            <TextBlock Text="Dodavanje novog proizvoda"
                       FontSize="16" FontWeight="Medium"
                       Foreground="{DynamicResource color1}"
                       FontFamily="Montserrat"
                       HorizontalAlignment="Center" Margin="0,0,0,20" 
                       Grid.Row="1"/>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" HorizontalAlignment="Center">

                    <StackPanel Margin="0,10">
                        <TextBlock Text="Šifra:" 
                               Style="{StaticResource TextBlockStyle}"/>

                        <TextBox x:Name="SifraTxt" 
                                 Style="{StaticResource TextBoxStyle}"
                                 PreviewTextInput="TextBox_PreviewTextInput"/>
                    </StackPanel>

                    <StackPanel Margin="0,10">
                        <TextBlock Text="Naziv:" 
                               Style="{StaticResource TextBlockStyle}"/>

                        <TextBox x:Name="NazivTxt" 
                             Style="{StaticResource TextBoxStyle}" />
                    </StackPanel>

                    <StackPanel Margin="0,10">
                        <TextBlock Text="Stanje:" 
                                   Style="{StaticResource TextBlockStyle}"/>

                        <TextBox x:Name="StanjeTxt" 
                            Style="{StaticResource TextBoxStyle}"
                                  PreviewTextInput="TextBox_PreviewTextInput"/>
                    </StackPanel>

                    <StackPanel Margin="0,10">
                        <TextBlock Text="Cijena (KM):" 
                                   Style="{StaticResource TextBlockStyle}" />

                        <TextBox x:Name="CijenaTxt" 
                             Style="{StaticResource TextBoxStyle}" 
                             PreviewTextInput="TextBox_PreviewTextDecimal"/>
                    </StackPanel>

                    <StackPanel Margin="0,10">
                        <TextBlock Text="Opis:" 
                               Style="{StaticResource TextBlockStyle}"/>

                        <TextBox x:Name="OpisTxt" 
                             Style="{StaticResource TextBoxStyle}" Height="50"
                             TextWrapping="Wrap" 
                             AcceptsReturn="True"/>
                    </StackPanel>

                </StackPanel>

                <StackPanel Grid.Column="1" HorizontalAlignment="Center">

                    <StackPanel Margin="0,10">
                        <TextBlock Text="Vrsta proizvoda:" 
                              Style="{StaticResource TextBlockStyle}"/>

                        <ComboBox x:Name="VrstaProizvodaComboBox"
                                  SelectionChanged="VrstaProizvodaComboBox_SelectionChanged"
                                  Width="200" Padding="5" VerticalAlignment="Center">
                            <ComboBoxItem Content="Asesoar" />
                            <ComboBoxItem Content="Ljubimac" />
                        </ComboBox>
                    </StackPanel>

                    <StackPanel x:Name="DodatnaPoljaPanel" Orientation="Vertical" Margin="0,10,0,0">

                    </StackPanel>

                    <Button Content="Sačuvaj"
                        Width="70" Height="30"
                        Margin="0,20,0,0" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Style="{DynamicResource dodajRadnikaButton}"
                        Click="SacuvajProizvodButton_Click" />

                </StackPanel>

            </Grid>

        </Grid>

    </Border>
</Window>
