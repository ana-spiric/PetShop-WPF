<UserControl x:Class="Pet_Shop_HCI.views.PregledRadnikaView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Pet_Shop_HCI.views"
             xmlns:classes="clr-namespace:Pet_Shop_HCI.classes"
             xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             >


    <Border Background="Transparent" Padding="10">
        <Grid>
            <Grid.RowDefinitions>
                <!--search bar-->
                <RowDefinition Height="50"/>
                <!--dugme dodaj radnika-->
                <RowDefinition Height="45"/>
                <!--tabela-->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,20,0">
                <Button Style="{DynamicResource dodajRadnikaButton}" Click="DodajRadnikaButton_Click">
                    <StackPanel Orientation="Horizontal" >
                        <fa:IconImage Icon="Plus" VerticalAlignment="Center" Width="11" 
                                      Height="11" Margin="0,1,8,0"/>
                        <TextBlock Text="Dodaj novog radnika"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <DockPanel Grid.Row="0" VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Margin="10,0,10,0">
                <fa:IconImage  DockPanel.Dock="Left" Icon="Search" Height="15" Width="15" Foreground="#200f53" Margin="0,0,5,0"/>
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                            x:Name="SearchTextBox"
                            VerticalAlignment="Stretch"
                            HorizontalAlignment="Stretch"
                            GotFocus="SearchTextBox_GotFocus"
                            Margin="0"
                            TextChanged="SearchTextBox_TextChanged"
                            VerticalContentAlignment="Center"
                            HorizontalContentAlignment="Left"
                            Height="30">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter"
                                    Command="{Binding Search}"/>
                    </TextBox.InputBindings>
                </TextBox>
            </DockPanel>

            <DataGrid x:Name="RadniciDataGrid"
                      Grid.Row="2"
                      ItemsSource="{Binding radniciView}"
                      AutoGenerateColumns="True"
                      Margin="10"
                      Style="{StaticResource CustomDataGridStyle}"
                      CanUserAddRows="False"
                      IsReadOnly="True"
                      AutoGeneratedColumns="DataGrid_AutoGeneratedColumns">
                <DataGrid.Columns>

                    <DataGridTemplateColumn>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Nalog"
                                            Command="{Binding DataContext.Nalog, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                            CommandParameter="{Binding}" 
                                            Style="{StaticResource editButton}">
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn>
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Izmijeni"
                                            Command="{Binding DataContext.Izmijeni, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                            CommandParameter="{Binding}" 
                                            Style="{StaticResource editButton}">
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                </DataGrid.Columns>
            </DataGrid>
        </Grid>

    </Border>
</UserControl>
