<Application x:Class="Pet_Shop_HCI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Pet_Shop_HCI" 
             xmlns:styles="clr-namespace:Pet_Shop_HCI.styles"
             StartupUri="LogIn.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/styles/UIColors.xaml"/>
                <ResourceDictionary Source="/styles/ButtonStyles.xaml"/>
                <ResourceDictionary Source="/styles/ZelenaTema.xaml"/>
                <ResourceDictionary Source="/styles/PlavaTema.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            
            <styles:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        </ResourceDictionary>
        
    </Application.Resources>
</Application>
